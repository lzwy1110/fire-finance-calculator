<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_horizontal">

    <!-- Top Bar: Logo & Today's Total Expense -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_sakura_flame" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="FIRE Flow"
            android:textColor="#f472b6"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Today's Total Expense Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="今日總支出"
                android:textColor="#9e9e9e"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/txt_today_expense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NT$ 0"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Step Progress / Breadcrumb Indicator with Previous Step & Reset Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="3dp"
        android:paddingHorizontal="6dp"
        android:background="#1f0a17">

        <TextView
            android:id="@+id/btn_prev_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ 上一步"
            android:textColor="#f472b6"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingEnd="6dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_step_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="第一步：請選擇【大類】"
            android:textColor="#ffffff"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_reset_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧹 重選"
            android:textColor="#888888"
            android:textSize="10sp"
            android:paddingHorizontal="4dp" />
    </LinearLayout>

    <!-- STEP 1: Main Category Selection Grid -->
    <LinearLayout
        android:id="@+id/layout_step_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btn_cat_food"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="🍔 飲食"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_cat_ent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="🎮 娛樂"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_cat_trans"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="🚗 交通"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btn_cat_daily"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="🛍️ 日用"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_cat_inc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="💰 收入"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_cat_inv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="🚀 投資"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- STEP 2: Sub Category Selection Grid (Dynamic Labels) -->
    <LinearLayout
        android:id="@+id/layout_step_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btn_sub_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="早餐"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_sub_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="午餐"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_sub_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="晚餐"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/btn_sub_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="宵夜"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_sub_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="飲料"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_sub_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="7dp"
                android:text="生鮮"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- STEP 3: Amount Numeric Keypad Grid -->
    <LinearLayout
        android:id="@+id/layout_step_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Real-time Entered Amount Display Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:background="#240a1b"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="輸入金額: NT$ "
                android:textColor="#f472b6"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_entered_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Keypad Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/key_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="1"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="2"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="3"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_plus100"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="+100"
                android:textColor="#f472b6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Keypad Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/key_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="4"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="5"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="6"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_plus500"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="+500"
                android:textColor="#f472b6"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Keypad Row 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/key_7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="7"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="8"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_9"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="9"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_del"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="⌫ 刪除"
                android:textColor="#ff8888"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Keypad Row 4: Clear, 0, 00, Confirm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="3dp">

            <TextView
                android:id="@+id/key_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="C 清空"
                android:textColor="#ffaa66"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="0"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_00"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/widget_item_bg"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="00"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/key_confirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:layout_marginStart="2dp"
                android:background="@drawable/widget_button_sakura"
                android:gravity="center"
                android:paddingVertical="5dp"
                android:text="✅ 確定"
                android:textColor="#000000"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action Button: Launch App Quick Add Modal -->
    <TextView
        android:id="@+id/btn_launch_app_modal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_button_sakura"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:text="⚡ + 自訂 (開啟 App 記帳彈窗)"
        android:textColor="#000000"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
